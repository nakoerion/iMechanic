{
  "name": "team-site-template",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "migrate": "bun run scripts/migrate.ts",
    "test": "vitest run --maxWorkers=2",
    "start": "bun run serve.ts",
    "publish": "bash ./publish.sh",
    "go-live": "bash ./go-live.sh",
    "format": "prettier --write .",
    "native:prepare": "node scripts/prepare-native-www.mjs",
    "native:copy": "bun run native:prepare && npx cap copy",
    "native:sync": "bun run build && bun run native:prepare && npx cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^7",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-router": "^1.158.1",
    "@tanstack/react-start": "^1.158.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/android": "^7",
    "@capacitor/cli": "^7",
    "@capacitor/ios": "^7",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
